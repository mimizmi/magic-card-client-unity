<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="login-root" style="padding: 24px; max-width: 100%; justify-content: flex-start; align-items: stretch; align-self: stretch; align-content: flex-start; width: 100%; height: 100%; max-height: 100%;">
        <ui:Label name="connection-status" style="width: 500px; height: 100px; font-size: 34px; -unity-text-align: middle-center; -unity-font-style: bold; left: 25%;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="ConnectionStatus" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
        <ui:TextField name="player-name" label="Player name" style="font-size: 30px;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="PlayerName" binding-mode="TwoWay" />
                <ui:DataBinding property="enabledSelf" data-source-path="IsConnected" binding-mode="ToTarget" />
            </Bindings>
        </ui:TextField>
        <ui:Button name="submit" text="Log in" style="font-size: 30px;">
            <Bindings>
                <ui:DataBinding property="enabledSelf" data-source-path="CanSubmit" binding-mode="ToTarget" />
            </Bindings>
        </ui:Button>
        <ui:Label name="result" style="white-space: normal; font-size: 30px; -unity-text-align: middle-center; -unity-font-style: bold;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="ResultText" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
        <ui:Label name="connection-fault" style="white-space: normal; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="ConnectionFaultText" binding-mode="ToTarget" />
            </Bindings>
        </ui:Label>
        <!--
            The queue panel. Every binding below resolves against THIS element's
            dataSource, not the root's: LoginView assigns a QueueViewModel to
            'queue-root', and UI Toolkit resolves a data-source-path against the
            nearest ancestor that has one. That is what lets two view-models share
            one document without either one growing the other's properties.
        -->
        <ui:VisualElement name="queue-root" style="margin-top: 24px; align-items: stretch;">
            <ui:Label name="queue-status" style="white-space: normal; font-size: 30px; -unity-text-align: middle-center;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="QueueStatusText" binding-mode="ToTarget" />
                </Bindings>
            </ui:Label>
            <ui:Button name="join-queue" text="Find match" style="font-size: 30px;">
                <Bindings>
                    <ui:DataBinding property="enabledSelf" data-source-path="CanJoin" binding-mode="ToTarget" />
                </Bindings>
            </ui:Button>
            <ui:Button name="leave-queue" text="Cancel" style="font-size: 30px;">
                <Bindings>
                    <ui:DataBinding property="enabledSelf" data-source-path="CanLeave" binding-mode="ToTarget" />
                </Bindings>
            </ui:Button>
            <ui:Label name="match" style="white-space: normal; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="MatchText" binding-mode="ToTarget" />
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
